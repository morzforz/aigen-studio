{
  "name": "@aigen-studio/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:show": "tsx src/cli/auth-show.ts"
  },
  "dependencies": {
    "@aigen-studio/shared": "workspace:*",
    "@hono/node-server": "^1.13.8",
    "better-sqlite3": "^11.8.1",
    "drizzle-orm": "^0.38.4",
    "hono": "^4.6.16",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
